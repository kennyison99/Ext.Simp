        "src/gm-bridge.js",
        "vendor/popper.min.js",
        "vendor/tippy.min.js",
        "vendor/file-saver.min.js",
        "vendor/jszip.min.js",
        "vendor/sha256.min.js",
        "src/gofile-token.js",
        "src/downloader.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://simpcity.cr/watched/threads*"
      ],
      "js": [
        "src/watched.js"
      ],
      "run_at": "document_idle"
    }
